{
  "manifest_version": 3,
  "name": "NexusKitty — Digital Rights Firewall",
  "version": "1.0.0",
  "description": "AI-powered digital rights firewall that reads Terms of Service and warns you before you click 'I Agree'.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://nexuskitty.onrender.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"]
    }
  ]
}